{
  "name": "sprintflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 --turbo",
    "build": "prisma generate && next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma generate && node prisma/apply-schema.cjs",
    "db:seed": "prisma db seed",
    "db:reset": "prisma generate && node prisma/apply-schema.cjs --reset && prisma db seed",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "lucide-react": "1.17.0",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.7",
    "postcss": "^8.5.15",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.16.0"
  }
}
